# Database Configuration
FINANCE_DB_PASSWORD=FinanceSecurePass123!

# JWT
JWT_SECRET=your-jwt-secret-here

# CORS
CORS_ALLOWED_ORIGINS=https://finance.tarasantoniuk.com,http://localhost:3000

# Google sign-in (OAuth client ID from Google Cloud Console; no client secret needed)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Notes:
# 1. Copy this file to .env and update the password
# 2. Must match FINANCE_DB_PASSWORD in infrastructure/.env
# 3. Never commit .env to git